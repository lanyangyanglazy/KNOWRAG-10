# ========================================
# LangChain RAG 项目环境变量配置模板
# ========================================
# 用法：复制本文件为 .env，填入真实值。.env 已被 .gitignore 忽略，不会提交。
#   cp .env.example .env

# ===== LLM Provider 切换 =====
# ollama（默认，本地离线、免费） | deepseek（在线，需下方 API Key）
LLM_PROVIDER=ollama

# ===== DeepSeek 在线模型配置 =====
# API Key 获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-key-here

# DeepSeek 模型选择：
#   deepseek-chat     —— V3.1，通用对话，便宜（约 $0.14/1M 输入 token）
#   deepseek-reasoner —— 推理型，会返回 reasoning_content（思考过程）
DEEPSEEK_MODEL=deepseek-chat

# ===== Ollama 本地模型（LLM_PROVIDER=ollama 时使用） =====
OLLAMA_LLM_MODEL=deepseek-r1:1.5b

# ===== Embedding 模型（始终本地 Ollama，与 LLM_PROVIDER 无关） =====
# DeepSeek 不提供 Embedding API，因此两种 provider 下都用本地 Ollama 做 embedding。
# 换模型（如 bge-m3）需先 ollama pull，且会触发 FAISS 索引重建。
#
# 注意：默认拒答阈值 RAG_MAX_DISTANCE=0.78 是按 bge-m3 在演示语料上校准的。
# 若改用其他 embedding，必须重新校准（见 app/README.md「拒答与阈值校准」）。
EMBED_MODEL=bge-m3

# ===== 政务原型：认证与审计（app/server.py） =====
# 演示口令：所有演示账号共用；可用 DEMO_PASSWORD_<用户名大写> 单独覆盖（如 DEMO_PASSWORD_WANG）。
# 生产环境不要使用本机制，应对接统一身份认证（OIDC / CAS / LDAP）。
DEMO_PASSWORD=demo-2026

# 会话密钥：生产必须从密钥管理系统注入。
# 留空则每次启动随机生成——重启即全员掉线，多进程/多副本会因密钥不同出现随机 401。
SESSION_SECRET=

# 审计写入后 fsync（政务场景建议保持 1；高吞吐可设 0 换取性能）
AUDIT_FSYNC=1

# 部署在反向代理之后时设为 1，审计才能记录真实客户端 IP；直接暴露时保持 0 以防伪造
TRUST_PROXY=0

# ===== LLM 预算与并发（main.py / app/server.py）=====
# 显式设置上下文与输出上限：Ollama 默认 num_ctx 偏小且超长时静默截断，表现为答案变差但无报错。
LLM_NUM_CTX=4096
LLM_NUM_PREDICT=1024
# 单次生成总预算（秒）：超时返回 error 事件并写审计，避免一个请求长期占线程。
LLM_TIMEOUT_S=120
# 上下文/历史字符预算（中文 1 字约 1 token，按保守值估算）。
MAX_CONTEXT_CHARS=6000
MAX_HISTORY_CHARS=3000
# 同时进行的问答请求上限：超出直接回 error 事件，不排队、不打满线程池。
MAX_CONCURRENT_CHATS=4

# 注：请确保 ollama serve 运行且已拉取 EMBED_MODEL 指定的模型。

# ===== 文档摄取（P0） =====
# 设置后 app/rag_service.py 默认走 pg；不设置则保持 FAISS
INGEST_DB_URL=postgresql://rag:rag@127.0.0.1:5433/rag
INGEST_TEST_DB_URL=postgresql://rag:rag@127.0.0.1:5433/rag_test
INGEST_UPLOAD_DIR=data/uploads
INGEST_STORAGE=fs
INGEST_MAX_FILE_MB=50
INGEST_QUEUE_MAX=200
INGEST_WORKERS=2
# 本机 LibreOffice 路径（Windows 示例）；不设置则查 PATH
# SOFFICE_BIN=C:\Program Files\LibreOffice\program\soffice.exe

# 文档摄取：嵌入与本地模型服务（与现有 FAISS 的 EMBED_MODEL 相互独立）
INGEST_EMBED_MODEL=bge-m3
INGEST_OLLAMA_BASE_URL=http://127.0.0.1:11434
